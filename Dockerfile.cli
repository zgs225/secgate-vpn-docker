# 奇安信 (网神) SecGate Access —— SD-WAN / SSL VPN Linux 命令行客户端容器（备用）
#
# 客户端来源（厂商官方下载站）：https://sdwanapp.qianxin.com/download.html?product-type=sdwan
# 先把 Ubuntu 包放到 vendor/Ubuntu_SDWANClient_Setup.deb（见 vendor/README.md）：
#   ./scripts/fetch-client-deb.sh cli
#   Package: sslvpnclient 1.1.2.x  Architecture: amd64
#   安装后只有一个 CLI 程序：/opt/sslvpnclient/secgateaccess（必须 root 运行）
#
# 与 Windows/macOS 版的图形客户端不同，Ubuntu/CentOS 包是纯命令行版：
# 它自己创建 tun0 设备、把 0.0.0.0/1 + 128.0.0.0/1 指向 tun0（等价于默认路由全走 VPN），
# 并改写 /etc/resolv.conf。因此容器需要 NET_ADMIN + /dev/net/tun。
#
# 容器内额外跑一个 microsocks，把「容器网络命名空间里已经过 VPN 的流量」以 SOCKS5
# 暴露到 1080，用法和你现有的 hagb/docker-atrust 镜像完全一致。
FROM ubuntu:24.04

LABEL org.opencontainers.image.title="secgate-access" \
      org.opencontainers.image.description="QiAnXin SecGate Access SSLVPN/SD-WAN client + microsocks SOCKS5" \
      org.opencontainers.image.version="1.1.2.65051" \
      org.opencontainers.image.source="https://sdwanapp.qianxin.com/download.html?product-type=sdwan"

ENV DEBIAN_FRONTEND=noninteractive

# microsocks: SOCKS5 服务端；iproute2: 客户端与排障都要用；procps: healthcheck 的 pgrep
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        microsocks \
        iproute2 \
        procps \
        ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# 安装官方 deb（无 Depends，dpkg 直接装即可）
COPY vendor/Ubuntu_SDWANClient_Setup.deb /tmp/
RUN dpkg -i /tmp/Ubuntu_SDWANClient_Setup.deb \
 && rm -f /tmp/Ubuntu_SDWANClient_Setup.deb \
 && test -x /opt/sslvpnclient/secgateaccess

WORKDIR /opt/sslvpnclient

# 1080 = SOCKS5（无认证，compose 里默认只绑 127.0.0.1）
EXPOSE 1080/tcp

CMD ["microsocks", "-i", "0.0.0.0", "-p", "1080"]
